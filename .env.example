# ─── BLACK LEVIATAN v29 — Variables de entorno ───────────────────────────────
# Copia este archivo como .env y configura las keys que necesites.
# Las keys son OPCIONALES — los módulos sin key muestran "skip" en lugar de fallar.
#
# cp .env.example .env
# micro .env   (o nano .env)

# ── APIs de Threat Intelligence ───────────────────────────────────────────────
BL_API__VIRUSTOTAL=
BL_API__SHODAN=
BL_API__GREYNOISE=
BL_API__HIBP=
BL_API__DEHASHED=
BL_API__DEHASHED_USER=
BL_API__GITHUB=

# ── Red / Evasión ─────────────────────────────────────────────────────────────
BL_EVASION__ENABLED=false
BL_EVASION__TOR_ENABLED=false
BL_EVASION__TOR_SOCKS_PORT=9050
BL_EVASION__TOR_CONTROL_PORT=9051
BL_EVASION__PROXY_POOL=
# Formato para múltiples proxies: socks5://1.2.3.4:1080,http://5.6.7.8:8080
BL_EVASION__ROTATE_USER_AGENTS=true
BL_EVASION__BACKOFF_BASE=2.0

# ── Performance ───────────────────────────────────────────────────────────────
BL_MODULE_TIMEOUT=120
BL_CONCURRENCY=10
BL_MAX_RETRIES=3

# ── Storage ───────────────────────────────────────────────────────────────────
BL_STORAGE__DB_PATH=data/black_leviatan.db
BL_STORAGE__DUCKDB_PATH=data/analytics.duckdb

# ── WebSocket Dashboard ───────────────────────────────────────────────────────
BL_DASHBOARD__WS_PORT=8765
BL_DASHBOARD__ENABLED=true
